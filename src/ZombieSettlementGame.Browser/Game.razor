@inject IJSRuntime JS
@implements IAsyncDisposable

<canvas id="yaeger-canvas"></canvas>

<div class="hud">
    <p class="hud__hint">Tap a building, then tap the grid to place it. (Keys 1/2/3 also work.)</p>
    <div class="hud__buildings" role="group" aria-label="Choose building to place">
        <button type="button" class="hud__button @SelectedClass(BuildingKind.Farm)" @onclick="() => SelectBuilding(BuildingKind.Farm)">
            <span aria-hidden="true">🌾</span> Farm
        </button>
        <button type="button" class="hud__button @SelectedClass(BuildingKind.House)" @onclick="() => SelectBuilding(BuildingKind.House)">
            <span aria-hidden="true">🏠</span> House
        </button>
        <button type="button" class="hud__button @SelectedClass(BuildingKind.Fence)" @onclick="() => SelectBuilding(BuildingKind.Fence)">
            <span aria-hidden="true">🧱</span> Fence
        </button>
    </div>
</div>

@code {
    private DotNetObjectReference<GameController>? _controllerRef;
    private BrowserRenderSurface? _renderSurface;
    private GameController? _controller;

    // Mirrors GameController._selectedKind purely for highlighting the active button; the
    // keyboard shortcuts change the controller's selection directly without going through this
    // field, so it can lag behind if both input methods are mixed — cosmetic only.
    private BuildingKind _selectedKind = BuildingKind.Farm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Load the Yaeger interop ES module so all [JSImport] functions become available.
        // JSHost.ImportAsync resolves relative paths against the runtime's own glue script,
        // which is served from wwwroot/_framework/ regardless of <base href> — so "../" (not
        // "/yaeger-browser.js", which ignores <base href> and breaks off the domain root) is
        // what lands back in wwwroot, letting the app run from a sub-path such as a GitHub
        // Pages project site.
        await JSHost.ImportAsync("yaeger-browser", "../yaeger-browser.js");

        _renderSurface = new BrowserRenderSurface("yaeger-canvas");
        _renderSurface.Initialize();

        _controller = new GameController(_renderSurface);
        _controllerRef = DotNetObjectReference.Create(_controller);

        // Hand a reference to the controller to the JS game loop pump.
        await JS.InvokeVoidAsync("startGameLoop", _controllerRef);
    }

    private void SelectBuilding(BuildingKind kind)
    {
        _controller?.SelectBuilding(kind);
        _selectedKind = kind;
    }

    private string SelectedClass(BuildingKind kind) =>
        kind == _selectedKind ? "hud__button--selected" : "";

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("stopGameLoop");
        _renderSurface?.Dispose();
        _controllerRef?.Dispose();
    }
}
