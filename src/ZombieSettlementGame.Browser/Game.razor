@using System.Threading
@inject IJSRuntime JS
@implements IAsyncDisposable

<canvas id="yaeger-canvas"></canvas>

<div class="hud">
    <div class="hud__resources" role="status" aria-label="Resources">
        <span class="hud__resource"><span aria-hidden="true">🪵</span> @(_controller?.Wood ?? 0)</span>
        <span class="hud__resource"><span aria-hidden="true">🌾</span> @(_controller?.Food ?? 0)</span>
        <span class="hud__resource"><span aria-hidden="true">🧟</span> @(_controller?.ZombieCount ?? 0)</span>
    </div>
    <p class="hud__hint">Tap a building, then tap the grid to place it. Sawmills must go next to trees. Zombies spawn at the walls and destroy whichever building is nearest — keep a ring of fences up. (Keys 1/2/3/4 also work.)</p>
    <div class="hud__buildings" role="group" aria-label="Choose building to place">
        <button type="button" class="hud__button @SelectedClass(BuildingKind.Farm) @AffordClass(BuildingKind.Farm)" @onclick="() => SelectBuilding(BuildingKind.Farm)">
            <span aria-hidden="true">🌾</span> Farm (@GameController.WoodCost(BuildingKind.Farm) 🪵)
        </button>
        <button type="button" class="hud__button @SelectedClass(BuildingKind.House) @AffordClass(BuildingKind.House)" @onclick="() => SelectBuilding(BuildingKind.House)">
            <span aria-hidden="true">🏠</span> House (@GameController.WoodCost(BuildingKind.House) 🪵)
        </button>
        <button type="button" class="hud__button @SelectedClass(BuildingKind.Fence) @AffordClass(BuildingKind.Fence)" @onclick="() => SelectBuilding(BuildingKind.Fence)">
            <span aria-hidden="true">🧱</span> Fence (@GameController.WoodCost(BuildingKind.Fence) 🪵)
        </button>
        <button type="button" class="hud__button @SelectedClass(BuildingKind.Sawmill) @AffordClass(BuildingKind.Sawmill)" @onclick="() => SelectBuilding(BuildingKind.Sawmill)">
            <span aria-hidden="true">🪚</span> Sawmill (@GameController.WoodCost(BuildingKind.Sawmill) 🪵)
        </button>
    </div>
</div>

@code {
    private DotNetObjectReference<GameController>? _controllerRef;
    private BrowserRenderSurface? _renderSurface;
    private GameController? _controller;

    // GameController's Wood/Food change every tick, driven by JS's requestAnimationFrame outside
    // Blazor's own render cycle, so nothing tells this component to re-render on its own; poll it
    // instead. Interval is cosmetic (resource HUD, not gameplay-critical) so a coarse refresh rate
    // keeps StateHasChanged calls cheap.
    private Timer? _hudRefreshTimer;

    // Mirrors GameController._selectedKind purely for highlighting the active button; the
    // keyboard shortcuts change the controller's selection directly without going through this
    // field, so it can lag behind if both input methods are mixed — cosmetic only.
    private BuildingKind _selectedKind = BuildingKind.Farm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Load the Yaeger interop ES module so all [JSImport] functions become available.
        // JSHost.ImportAsync resolves relative paths against the runtime's own glue script,
        // which is served from wwwroot/_framework/ regardless of <base href> — so "../" (not
        // "/yaeger-browser.js", which ignores <base href> and breaks off the domain root) is
        // what lands back in wwwroot, letting the app run from a sub-path such as a GitHub
        // Pages project site.
        await JSHost.ImportAsync("yaeger-browser", "../yaeger-browser.js");

        _renderSurface = new BrowserRenderSurface("yaeger-canvas");
        _renderSurface.Initialize();

        _controller = new GameController(_renderSurface);
        _controllerRef = DotNetObjectReference.Create(_controller);

        // Hand a reference to the controller to the JS game loop pump.
        await JS.InvokeVoidAsync("startGameLoop", _controllerRef);

        _hudRefreshTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, dueTime: 200, period: 200);
    }

    private void SelectBuilding(BuildingKind kind)
    {
        _controller?.SelectBuilding(kind);
        _selectedKind = kind;
    }

    private string SelectedClass(BuildingKind kind) =>
        kind == _selectedKind ? "hud__button--selected" : "";

    private string AffordClass(BuildingKind kind) =>
        _controller is not null && _controller.Wood < GameController.WoodCost(kind)
            ? "hud__button--unaffordable"
            : "";

    public async ValueTask DisposeAsync()
    {
        _hudRefreshTimer?.Dispose();
        await JS.InvokeVoidAsync("stopGameLoop");
        _renderSurface?.Dispose();
        _controllerRef?.Dispose();
    }
}
